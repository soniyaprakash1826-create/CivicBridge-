# Dedicated scheme API (recommended)
# Expected JSON: {"schemes": [{"name": "...", "state": "Maharashtra", ...}]}
SCHEME_API_URL=
SCHEME_API_TOKEN=

# Optional Government of India Open Government Data API
# Get an API key from data.gov.in and provide resource IDs that contain scheme data.
DATA_GOV_API_KEY=
DATA_GOV_RESOURCE_IDS=
